// Unika — js/main.js
// Pagina Negozio: i clienti aggiungono prodotti a un riepilogo che si
// aggiorna in tempo reale (nome, quantità, totale). Alla conferma
// possono inviare la richiesta via email, su WhatsApp, oppure copiare
// il testo dell'ordine per incollarlo manualmente altrove. In tutti i
// casi il messaggio (riepilogo, totale dovuto in negozio, orario di
// ritiro desiderato) viene precompilato automaticamente, in attesa di
// conferma dello studio. Nessun pagamento online: senza un server non
// è possibile inviare in automatico, quindi si apre il client di
// posta o WhatsApp del cliente con tutto già scritto, pronto per un
// click.
(function () {
  // <-- SOSTITUISCI con l'indirizzo email reale a cui devono arrivare gli ordini
  var EMAIL_DESTINATARIO = 'ordini@unikastudio.it';
  var WHATSAPP_NUMBER = '393759702283';

  var cart = [];

  function formatEuro(n) {
    return '€ ' + n.toFixed(2).replace('.', ',');
  }

  function updateSendButtonsState() {
    var ids = ['btn-invia-email', 'btn-invia-whatsapp', 'btn-copia-testo'];
    for (var i = 0; i < ids.length; i++) {
      var el = document.getElementById(ids[i]);
      if (el) el.classList.toggle('disabled', cart.length === 0);
    }
  }

  function renderCart() {
    var box = document.getElementById('cart-summary');
    if (!box) return;
    var totalRow = box.querySelector('.cart-total-row');
    var emptyMsg = box.querySelector('.cart-empty');

    var oldRows = box.querySelectorAll('.cart-row');
    for (var i = 0; i < oldRows.length; i++) oldRows[i].remove();

    if (!cart.length) {
      if (emptyMsg) emptyMsg.style.display = '';
      if (totalRow) totalRow.style.display = 'none';
      updateSendButtonsState();
      return;
    }
    if (emptyMsg) emptyMsg.style.display = 'none';

    var total = 0;
    cart.forEach(function (item, idx) {
      total += item.price * item.qty;
      var row = document.createElement('div');
      row.className = 'cart-row';
      row.innerHTML =
        '<span class="cart-row-name">' + item.name + '</span>' +
        '<span class="cart-row-qty">' +
        '<button type="button" data-act="dec" data-idx="' + idx + '">−</button>' +
        '<span>' + item.qty + '</span>' +
        '<button type="button" data-act="inc" data-idx="' + idx + '">+</button>' +
        '</span>' +
        '<span class="cart-row-price">' + formatEuro(item.price * item.qty) + '</span>' +
        '<button type="button" class="cart-row-remove" data-act="rm" data-idx="' + idx + '">Rimuovi</button>';
      box.insertBefore(row, totalRow);
    });

    if (totalRow) {
      totalRow.style.display = 'flex';
      var totalEl = document.getElementById('cart-total');
      if (totalEl) totalEl.textContent = formatEuro(total);
    }

    updateSendButtonsState();
  }

  function addToCart(name, price, btn) {
    var existing = null;
    for (var i = 0; i < cart.length; i++) {
      if (cart[i].name === name) { existing = cart[i]; break; }
    }
    if (existing) existing.qty += 1;
    else cart.push({ name: name, price: price, qty: 1 });
    renderCart();

    if (btn) {
      var original = btn.textContent;
      btn.textContent = 'Aggiunto ✓';
      btn.classList.add('added');
      setTimeout(function () {
        btn.textContent = original;
        btn.classList.remove('added');
      }, 900);
    }
  }

  function raccogliDati() {
    if (!cart.length) {
      alert('Aggiungi almeno un prodotto al riepilogo prima di inviare la richiesta.');
      return null;
    }
    var nome = (document.getElementById('ord-nome') || {}).value || '';
    var contatto = (document.getElementById('ord-contatto') || {}).value || '';
    var orario = (document.getElementById('ord-orario') || {}).value || '';
    var note = (document.getElementById('ord-note') || {}).value || '';

    if (!nome || !contatto) {
      alert('Inserisci nome ed email o telefono per continuare.');
      return null;
    }

    var totale = 0;
    var righe = cart.map(function (item) {
      totale += item.price * item.qty;
      return '- ' + item.name + '  x' + item.qty + '   (' + formatEuro(item.price * item.qty) + ')';
    });

    return { nome: nome, contatto: contatto, orario: orario, note: note, righe: righe, totale: totale };
  }

  function componiMessaggio(dati) {
    var parti = [
      'Nuova richiesta d'ordine dal sito Unika:',
      '',
      dati.righe.join('
'),
      '',
      'Totale dovuto in negozio: ' + formatEuro(dati.totale),
      '',
      'Nome: ' + dati.nome,
      'Contatto: ' + dati.contatto,
      'Orario di ritiro desiderato: ' + (dati.orario || 'da concordare') + ' (da confermare da parte dello studio)'
    ];
    if (dati.note) parti.push('Note: ' + dati.note);
    parti.push('', '(Pagamento e ritiro esclusivamente in negozio — nessun pagamento online)');
    return parti.join('
');
  }

  function initShop() {
    var cartBox = document.getElementById('cart-summary');
    if (!cartBox) return; // non siamo nella pagina Negozio

    // Delega l'ascolto del click a tutto il documento: così funziona anche
    // per schede prodotto aggiunte DOPO il caricamento della pagina (blocco
    // "Scheda prodotto", duplicazioni con l'editor, ecc.), non solo per
    // quelle presenti all'avvio.
    document.addEventListener('click', function (e) {
      var addBtn = e.target.closest('.btn-add-cart');
      if (addBtn) {
        var card = addBtn.closest('.shop-card');
        if (!card) return;
        var name = card.getAttribute('data-product') || '';
        var price = parseFloat(card.getAttribute('data-price')) || 0;
        addToCart(name, price, addBtn);
        return;
      }
      var qtyBtn = e.target.closest('[data-act]');
      if (qtyBtn && cartBox.contains(qtyBtn)) {
        var idx = parseInt(qtyBtn.getAttribute('data-idx'), 10);
        var act = qtyBtn.getAttribute('data-act');
        if (act === 'inc') cart[idx].qty += 1;
        if (act === 'dec') { cart[idx].qty -= 1; if (cart[idx].qty <= 0) cart.splice(idx, 1); }
        if (act === 'rm') cart.splice(idx, 1);
        renderCart();
      }
    });

    renderCart();

    var form = document.getElementById('form-ordina');
    if (form) {
      form.addEventListener('submit', function (e) { e.preventDefault(); });
    }

    var btnEmail = document.getElementById('btn-invia-email');
    if (btnEmail) {
      btnEmail.addEventListener('click', function () {
        var dati = raccogliDati();
        if (!dati) return;
        var corpo = componiMessaggio(dati);
        var oggetto = 'Richiesta ordine — ' + dati.nome;
        var mailto = 'mailto:' + EMAIL_DESTINATARIO +
          '?subject=' + encodeURIComponent(oggetto) +
          '&body=' + encodeURIComponent(corpo);
        window.location.href = mailto;
      });
    }

    var btnWhatsapp = document.getElementById('btn-invia-whatsapp');
    if (btnWhatsapp) {
      btnWhatsapp.addEventListener('click', function () {
        var dati = raccogliDati();
        if (!dati) return;
        var corpo = componiMessaggio(dati);
        var url = 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(corpo);
        window.open(url, '_blank');
      });
    }

    var btnCopia = document.getElementById('btn-copia-testo');
    if (btnCopia) {
      btnCopia.addEventListener('click', function () {
        var dati = raccogliDati();
        if (!dati) return;
        var corpo = componiMessaggio(dati);
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(corpo).then(function () {
            alert('Testo dell'ordine copiato! Ora puoi incollarlo dove preferisci (Instagram, SMS, ecc.).');
          }, function () {
            window.prompt('Copia manualmente il testo qui sotto (Ctrl+C / Cmd+C):', corpo);
          });
        } else {
          window.prompt('Copia manualmente il testo qui sotto (Ctrl+C / Cmd+C):', corpo);
        }
      });
    }

    updateSendButtonsState();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShop);
  } else {
    initShop();
  }
})();
